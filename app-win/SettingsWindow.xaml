<Window x:Class="TetherApp.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings">
 <NavigationView x:Name="SettingsRoot" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
  IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="220"
  Background="Transparent" SelectionChanged="Section_Changed">
  <NavigationView.Resources>
   <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
   <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
   <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
  </NavigationView.Resources>
  <NavigationView.MenuItems>
   <NavigationViewItem Content="General" Tag="startup" Icon="Play" IsSelected="True" />
   <NavigationViewItem Content="Appearance" Tag="appearance" Icon="FontColor" />
   <NavigationViewItem Content="Terminal" Tag="terminal" Icon="Keyboard" />
   <NavigationViewItem Content="Key Bindings" Tag="keys" Icon="Keyboard" />
   <NavigationViewItem Content="Session History" Tag="history" Icon="Clock" />
   <NavigationViewItem Content="Security" Tag="security" Icon="ProtectedDocument" />
   <NavigationViewItem Content="Files" Tag="files" Icon="Folder" />
   <NavigationViewItem Content="Identities" Tag="identities" Icon="Contact" />
   <NavigationViewItem Content="Extensions" Tag="extensions" Icon="AllApps" />
  </NavigationView.MenuItems>
  <NavigationView.PaneFooter>
   <Border Padding="16,10" BorderBrush="{ThemeResource ChromeStrokeBrush}" BorderThickness="0,1,0,0">
    <Grid>
     <TextBlock Text="Tether" VerticalAlignment="Center" />
     <TextBlock x:Name="VersionLabel" Text="v0.1.0" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6" />
    </Grid>
   </Border>
  </NavigationView.PaneFooter>
  <ScrollViewer Padding="{StaticResource SettingsPageInset}">
   <StackPanel Spacing="{StaticResource SpaceSection}" MaxWidth="640" HorizontalAlignment="Stretch">
    <TextBlock x:Name="PageHeading" Text="General" Style="{StaticResource SubtitleTextBlockStyle}" />
    <Border x:Name="StartupPane" Style="{StaticResource SettingsCardStyle}">
     <StackPanel Spacing="{StaticResource SpaceGroup}">
      <TextBlock Text="Default profile" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <TextBlock Text="Choose the shell to open when Tether starts or you open a new tab."
       Foreground="{ThemeResource ChromeSubtleBrush}" TextWrapping="Wrap" />
      <ComboBox x:Name="ShellPicker" HorizontalAlignment="Stretch"
       AutomationProperties.Name="Default profile" SelectionChanged="Shell_Changed" />
      <ComboBox x:Name="WslPicker" Header="WSL distribution" HorizontalAlignment="Stretch" />
      <TextBlock Text="PowerShell uses PowerShell 7 when available."
       Foreground="{ThemeResource ChromeSubtleBrush}" TextWrapping="Wrap" />
      <TextBlock Text="When the last tab closes" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <TextBlock Text="Keep an empty window, or quit Tether when nothing remains open."
       Foreground="{ThemeResource ChromeSubtleBrush}" TextWrapping="Wrap" />
      <ComboBox x:Name="LastTabPicker" HorizontalAlignment="Stretch"
       AutomationProperties.Name="When the last tab closes" SelectionChanged="LastTab_Changed">
       <ComboBoxItem Content="No open terminals" Tag="stay" />
       <ComboBoxItem Content="Quit" Tag="quit" />
      </ComboBox>
     </StackPanel>
    </Border>
    <Border x:Name="SshPane" Style="{StaticResource SettingsCardStyle}">
     <StackPanel Spacing="{StaticResource SpaceGroup}">
      <TextBlock Text="SSH client" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <TextBlock Text="ssh.exe used when a connection can be reused. Windows OpenSSH is the default."
       Foreground="{ThemeResource ChromeSubtleBrush}" TextWrapping="Wrap" />
      <ComboBox x:Name="SshPicker" HorizontalAlignment="Stretch"
       AutomationProperties.Name="SSH client" SelectionChanged="Ssh_Changed" />
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <TextBox x:Name="SshPathBox" Header="Path" AutomationProperties.Name="SSH client path"
        LostFocus="SshPath_LostFocus" />
       <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom" Click="SshBrowse_Click"
        AutomationProperties.Name="Browse for ssh.exe" />
      </Grid>
      <TextBlock x:Name="SshPathProblem" Foreground="{ThemeResource ChromeSubtleBrush}"
       TextWrapping="Wrap" Visibility="Collapsed" />
     </StackPanel>
    </Border>
    <Border x:Name="AppearancePane" Visibility="Collapsed" Style="{StaticResource SettingsCardStyle}">
     <StackPanel Spacing="{StaticResource SpaceGroup}">
      <TextBlock Text="Application theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <TextBlock Text="Apply a theme to the window and terminal. Changes take effect immediately."
       Foreground="{ThemeResource ChromeSubtleBrush}" TextWrapping="Wrap" />
      <ComboBox x:Name="ThemePicker" HorizontalAlignment="Stretch"
       AutomationProperties.Name="Application theme" SelectionChanged="Theme_Changed">
       <ComboBoxItem Content="Use system theme" Tag="system" />
       <ComboBoxItem Content="Dark" Tag="dark" />
       <ComboBoxItem Content="Light" Tag="light" />
      </ComboBox>
     </StackPanel>
    </Border>
    <StackPanel x:Name="TerminalPane" Visibility="Collapsed" Spacing="12" />
    <StackPanel x:Name="KeysPane" Visibility="Collapsed" Spacing="12" />
    <StackPanel x:Name="HistoryPane" Visibility="Collapsed" Spacing="12" />
    <StackPanel x:Name="SecurityPane" Visibility="Collapsed" Spacing="12" />
    <StackPanel x:Name="FilesPane" Visibility="Collapsed" Spacing="12" />
    <StackPanel x:Name="IdentitiesPane" Visibility="Collapsed" Spacing="12" />
    <StackPanel x:Name="ExtensionsPane" Visibility="Collapsed" Spacing="{StaticResource SpaceGroup}" />
    <TextBlock x:Name="SaveProblem" Foreground="{ThemeResource ChromeSubtleBrush}"
     TextWrapping="Wrap" Visibility="Collapsed" />
   </StackPanel>
  </ScrollViewer>
 </NavigationView>
</Window>
