<Application
    x:Class="TetherApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--
              Theme's semantic roles (TetherUI/Chrome.swift): window /
              sidebar / raised / stroke / text / subtle. The terminal body is
              the palette's, not the system's.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ChromeWindowBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ChromeSidebarBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="ChromeRaisedBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="ChromeStrokeBrush" Color="#3F3F3F" />
                    <SolidColorBrush x:Key="ChromeTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ChromeSubtleBrush" Color="#A0A0A0" />
                    <SolidColorBrush x:Key="TerminalBackground" Color="#12141A" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#60A5FA" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ChromeWindowBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="ChromeSidebarBrush" Color="#ECECEC" />
                    <SolidColorBrush x:Key="ChromeRaisedBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ChromeStrokeBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="ChromeTextBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="ChromeSubtleBrush" Color="#6B6B6B" />
                    <SolidColorBrush x:Key="TerminalBackground" Color="#12141A" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
