<UserControl x:Class="TetherApp.Files.FilesPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{ThemeResource ChromeSidebarBrush}" Padding="{StaticResource ContentInset}" RowSpacing="{StaticResource SpaceGroup}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Files" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{StaticResource InputSize}"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="&#xE72B;" Style="{StaticResource ChromeIconButtonStyle}" Click="Back_Click" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back"/>
    <Button Content="&#xE74A;" Style="{StaticResource ChromeIconButtonStyle}" Click="Up_Click" ToolTipService.ToolTip="Up" AutomationProperties.Name="Up"/>
    <Button Content="&#xE72C;" Style="{StaticResource ChromeIconButtonStyle}" Click="Refresh_Click" ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh"/>
    <Button Content="&#xE712;" Style="{StaticResource ChromeIconButtonStyle}" ToolTipService.ToolTip="File actions" AutomationProperties.Name="File actions">
     <Button.Flyout><MenuFlyout>
      <MenuFlyoutItem Text="Home" Click="Home_Click"/>
      <MenuFlyoutItem Text="Go to Terminal Directory" Click="TerminalDirectory_Click"/>
      <MenuFlyoutItem Text="New Folder" Click="NewFolder_Click"/>
      <MenuFlyoutSeparator/>
      <MenuFlyoutItem Text="Upload Files…" Click="Upload_Click"/>
      <MenuFlyoutItem Text="Upload Folder…" Click="UploadFolder_Click"/>
      <ToggleMenuFlyoutItem x:Name="HiddenToggle" Text="Show Hidden Files" Click="Hidden_Click"/>
     </MenuFlyout></Button.Flyout>
    </Button>
    <Button Content="&#xE711;" Style="{StaticResource ChromeIconButtonStyle}" Click="Close_Click" ToolTipService.ToolTip="Hide Files" AutomationProperties.Name="Hide Files"/>
   </StackPanel>
  </Grid>
  <TextBox x:Name="Address" Grid.Row="1" KeyDown="Address_KeyDown" AutomationProperties.Name="Directory" FontSize="{StaticResource InputSize}"/>
  <Grid Grid.Row="2">
   <ListView x:Name="Entries" SelectionMode="Extended" DoubleTapped="Entries_DoubleTapped" KeyDown="Entries_KeyDown"
    AllowDrop="True" DragOver="Entries_DragOver" Drop="Entries_Drop" RightTapped="Entries_RightTapped" AutomationProperties.Name="Files">
    <ListView.ItemTemplate><DataTemplate>
     <Grid ColumnSpacing="{StaticResource SpaceGroup}" Margin="{Binding Indent}" Padding="0,4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="{Binding ExpandGlyph}" IsEnabled="{Binding CanExpand}" Tag="{Binding Entry.Path}" Click="Expand_Click" DoubleTapped="Expand_DoubleTapped"
       Padding="2" MinWidth="16" MinHeight="20" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Expand or collapse folder"/>
      <FontIcon Grid.Column="1" Glyph="{Binding Glyph}" FontSize="{StaticResource SymbolSize}"/>
      <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource InputSize}" ToolTipService.ToolTip="{Binding Name}"/>
      <TextBlock Grid.Column="3" Text="{Binding Size}" Style="{StaticResource DetailTextStyle}" VerticalAlignment="Center"/>
     </Grid>
    </DataTemplate></ListView.ItemTemplate>
    <ListView.ContextFlyout><MenuFlyout>
     <MenuFlyoutItem Text="Open" Click="Open_Click"/>
     <MenuFlyoutItem Text="Save As…" Click="Download_Click"/>
     <MenuFlyoutItem Text="Copy Path" Click="CopyPath_Click"/>
     <MenuFlyoutItem Text="Insert Path" Click="InsertPath_Click"/>
     <MenuFlyoutSeparator/>
     <MenuFlyoutItem Text="Rename…" Click="Rename_Click"/>
     <MenuFlyoutItem Text="Move To…" Click="Move_Click"/>
     <MenuFlyoutItem Text="Delete…" Click="Delete_Click"/>
    </MenuFlyout></ListView.ContextFlyout>
   </ListView>
   <TextBlock x:Name="Empty" Text="This folder is empty." IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DetailTextStyle}" Visibility="Collapsed"/>
  </Grid>
  <StackPanel Grid.Row="3" Spacing="{StaticResource SpaceGroup}">
   <TextBlock x:Name="Problem" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
   <ProgressBar x:Name="ProgressBar" Visibility="Collapsed" IsIndeterminate="True"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="Activity" TextWrapping="Wrap" Style="{StaticResource DetailTextStyle}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed"/>
   </Grid>
  </StackPanel>
 </Grid>
</UserControl>
