<Window
    x:Class="TetherApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tether">

    <!--
      The macOS shape, in order and in size (WorkspaceChrome.swift):
        WorkspaceTabBar  36   top,    sidebar surface, bottom divider
        canvas           *    middle, 12pt inset
        HostStatusBar    24   bottom, sidebar surface, top divider

      Terminal tabs carry no symbol and no global + or ✕: the close box
      lives on the chip and appears under the pointer (law app-ui-chrome).
      New Terminal is ⌃N, Close Tab is ⌃W — the menu equivalents of ⌘N/⌘W.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- WorkspaceTabBar -->
        <Grid Grid.Row="0" Background="{ThemeResource ChromeSidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="TabStrip"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch" />
            <Rectangle Grid.Row="1" Fill="{ThemeResource ChromeStrokeBrush}" />
        </Grid>

        <!-- canvas: the terminal. 12pt inset, the way TerminalSurface does. -->
        <Grid x:Name="TerminalHostPlaceholder" Grid.Row="1" Margin="12" Background="{ThemeResource TerminalBackground}" />

        <!-- HostStatusBar -->
        <Grid Grid.Row="2" Background="{ThemeResource ChromeSidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Fill="{ThemeResource ChromeStrokeBrush}" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The host control leads: it is the picker. -->
                <Button x:Name="HostButton"
                        Grid.Column="0"
                        Padding="12,0"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Stretch"
                        Click="Connect_Click"
                        AutomationProperties.Name="Host"
                        AutomationProperties.HelpText="Choose host">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="StatusDot"
                                 Width="7" Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{ThemeResource ChromeSubtleBrush}" />
                        <TextBlock x:Name="HostName"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Text="Choose host" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10"
                                  Foreground="{ThemeResource ChromeSubtleBrush}"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel x:Name="StatusMark"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center" />

                <Button x:Name="SettingsButton" Click="Settings_Click"
                        Grid.Column="3"
                        Width="28" Padding="0"
                        Margin="0,0,12,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Settings"
                        AutomationProperties.Name="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="11"
                              Foreground="{ThemeResource ChromeSubtleBrush}" />
                </Button>
            </Grid>
        </Grid>

        <!--
          HostPicker, anchored above the host bar and not a system popover —
          those clip at the window edge (WorkspaceChrome.swift). Search over
          ~/.ssh/config, and a footer with Add host / Manage hosts.
        -->
        <Border x:Name="HostPickerPanel"
                Grid.Row="0" Grid.RowSpan="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10,0,0,32"
                MaxWidth="320"
                Background="{ThemeResource ChromeRaisedBrush}"
                BorderBrush="{ThemeResource ChromeStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Visibility="Collapsed">
            <StackPanel Spacing="8">
                <TextBox x:Name="HostQuery"
                         PlaceholderText="Find a host…"
                         FontSize="12"
                         TextChanged="HostQuery_Changed" />
                <TextBlock x:Name="HostProblem"
                           FontSize="11"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <ListView x:Name="HostList"
                          MaxHeight="280"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="Host_Click"
                          Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Label}" FontSize="12" />
                                <TextBlock Text="{Binding Target}" FontSize="10"
                                           Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Rectangle Height="1" Fill="{ThemeResource ChromeStrokeBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AddHostButton"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Add host"
                            AutomationProperties.Name="Add host"
                            Click="AddHost_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="14"
                                  Foreground="{ThemeResource ChromeSubtleBrush}" />
                    </Button>
                    <Button x:Name="ManageHostsButton"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Manage hosts"
                            AutomationProperties.Name="Manage hosts"
                            Click="ManageHosts_Click">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14"
                                  Foreground="{ThemeResource ChromeSubtleBrush}" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
