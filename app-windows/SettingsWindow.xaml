<Window x:Class="TetherApp.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings">
 <NavigationView x:Name="SettingsRoot" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
  IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="220"
  Background="{ThemeResource ChromeWindowBrush}" SelectionChanged="Section_Changed">
  <NavigationView.MenuItems>
   <NavigationViewItem Content="Startup" Tag="startup" Icon="Play" IsSelected="True" />
   <NavigationViewItem Content="Appearance" Tag="appearance" Icon="FontColor" />
   <NavigationViewItem Content="Extensions" Tag="extensions" Icon="AllApps" />
  </NavigationView.MenuItems>
  <ScrollViewer Padding="{StaticResource SettingsPageInset}">
   <StackPanel Spacing="{StaticResource SpaceSection}" MaxWidth="640" HorizontalAlignment="Stretch">
    <TextBlock x:Name="PageHeading" Text="Startup" Style="{StaticResource SubtitleTextBlockStyle}" />
    <Border x:Name="StartupPane" Background="{ThemeResource ChromeRaisedBrush}" CornerRadius="{StaticResource RowRadius}"
     Padding="{StaticResource SettingsCardInset}" BorderThickness="1" BorderBrush="{ThemeResource ChromeStrokeBrush}">
     <StackPanel Spacing="{StaticResource SpaceGroup}">
      <TextBlock Text="Default profile" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <TextBlock Text="Choose the shell to open when Tether starts or you open a new tab."
       Foreground="{ThemeResource ChromeSubtleBrush}" TextWrapping="Wrap" />
      <ComboBox x:Name="ShellPicker" HorizontalAlignment="Stretch"
       AutomationProperties.Name="Default profile" SelectionChanged="Shell_Changed" />
      <TextBlock Text="WSL opens your default Linux distribution. PowerShell uses PowerShell 7 when available."
       Foreground="{ThemeResource ChromeSubtleBrush}" TextWrapping="Wrap" />
     </StackPanel>
    </Border>
    <Border x:Name="AppearancePane" Visibility="Collapsed"
     Background="{ThemeResource ChromeRaisedBrush}" CornerRadius="{StaticResource RowRadius}"
     Padding="{StaticResource SettingsCardInset}" BorderThickness="1" BorderBrush="{ThemeResource ChromeStrokeBrush}">
     <StackPanel Spacing="{StaticResource SpaceGroup}">
      <TextBlock Text="Application theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <TextBlock Text="Apply a theme to the window and terminal. Changes take effect immediately."
       Foreground="{ThemeResource ChromeSubtleBrush}" TextWrapping="Wrap" />
      <ComboBox x:Name="ThemePicker" HorizontalAlignment="Stretch"
       AutomationProperties.Name="Application theme" SelectionChanged="Theme_Changed">
       <ComboBoxItem Content="Use system theme" Tag="system" />
       <ComboBoxItem Content="Dark" Tag="dark" />
       <ComboBoxItem Content="Light" Tag="light" />
      </ComboBox>
     </StackPanel>
    </Border>
    <StackPanel x:Name="ExtensionsPane" Visibility="Collapsed" Spacing="{StaticResource SpaceGroup}" />
    <TextBlock x:Name="SaveProblem" Foreground="{ThemeResource ChromeSubtleBrush}"
     TextWrapping="Wrap" Visibility="Collapsed" />
   </StackPanel>
  </ScrollViewer>
 </NavigationView>
</Window>
