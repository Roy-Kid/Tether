.DS_Store
/target
**/*.rs.bk
Cargo.lock.orig
.claude/settings.local.json
.build/
# Build output: 163MB of static libraries, produced by
# scripts/build-xcframework.sh and published with a release, never committed.
swift/Artifacts/

# Assembled application bundles, produced by scripts/build-app.sh and
# scripts/build-app-ios.sh. Hundreds of megabytes, reproducible from source.
/build/

# Fuzzing. The corpus ./scripts/fuzz-targets.sh grows and its build are
# outputs; a crashing input is not — it belongs under fuzz/artifacts/ as a
# committed regression.
/fuzz/corpus/
/fuzz/target/
# Crashes land here; a fixed one is moved to fuzz/regressions/ and committed.
/fuzz/artifacts/

# Browser-automation logs; a tool's scratch, not the project's.
/.playwright-mcp/

# .NET build output and Visual Studio state. The native DLL staged under
# runtimes/ is produced by scripts/build-windows.ps1 and never committed
# (Decisions/0017).
.vs/
/app-windows/bin/
/dotnet/**/bin/
/tests/**/bin/
/app-windows/obj/
/dotnet/**/obj/
/tests/**/obj/
/dotnet/Tether/runtimes/

# Isolated font-fix application build used while the main executable is open.
/artifacts/font-preview/
# Python bytecode caches from the corpus helpers; never source.
__pycache__/

/artifacts/merged-swift-bindings/

# Side-by-side Windows trial builds and font-render diagnostics.
/artifacts/windows-*/
/artifacts/han-*.png
/artifacts/han-*.ppm
